{
  "id": "social.press-banner",
  "kind": "section",
  "scope": "body",
  "category": "social",
  "evidenceKey": "section.social.press-banner",
  "source": "src/components/PressBanner.jsx",
  "description": "Four press logos in four static slots on {color.dust}. @1440 padding 160px 0 72px, wrapper gap-y 72px.",
  "surface": "light",
  "content": {
    "required": [
      "logos"
    ],
    "additionalProperties": false,
    "properties": {
      "heading": {
        "type": "string",
        "maxWords": 10
      },
      "logos": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "media",
            "href"
          ],
          "properties": {
            "media": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetRole",
                "alt",
                "provenance"
              ],
              "properties": {
                "assetRole": {
                  "enum": [
                    "brand.press-logo"
                  ]
                },
                "alt": {
                  "type": "string",
                  "maxWords": 6
                },
                "src": {
                  "type": "string"
                },
                "intrinsicWidth": {
                  "type": "integer"
                },
                "intrinsicHeight": {
                  "type": "integer"
                },
                "provenance": {
                  "enum": [
                    "source-original",
                    "operator-supplied",
                    "generated"
                  ],
                  "note": "Provenance of this asset in the page being specified. `generated` is FORBIDDEN for any assetRole whose generationPolicy is must-not-fabricate-real-brand or must-not-fabricate-compliance-claim, and for must-reuse-exact roles. Enforced by compatibility/graph.json#ASSET_PROVENANCE_POLICY and schema/semantic_validate.py."
                },
                "aspectRatio": {
                  "type": "string",
                  "note": "CSS aspect-ratio for the wrapper box (e.g. \"799/617\"). Used by Rive assets, which have no intrinsic pixel size, INSTEAD of intrinsicWidth/Height."
                }
              }
            },
            "href": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "constraints": {
    "maxPerPage": 1
  },
  "motion": {
    "pattern": "stagger-reveal",
    "reducedMotionFallback": "all-slots-opaque",
    "duration": "500ms",
    "easing": "ease-out",
    "staggerMs": 80,
    "notes": "4 logos in 4 slots means NO cycling — entrance animation only. Each slot keeps its own will-change-transform wrapper div."
  },
  "responsive": {
    "base": "row wraps",
    "md768": "single row"
  }
}
