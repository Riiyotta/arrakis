{
  "id": "platform.stacked-panels",
  "kind": "section",
  "scope": "body",
  "category": "feature",
  "evidenceKey": "section.platform.stacked-panels",
  "source": "src/components/platform/StackedPanels.jsx; src/data/platform.js",
  "description": "/platform slot 1: `stackedPanels` x4 in one <section>. transitionBlackToWhite, pt 200 / pb 160, spaceBetween 400, sectionId `build`.",
  "surface": "both",
  "content": {
    "required": [
      "panels"
    ],
    "additionalProperties": false,
    "properties": {
      "panels": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "heading",
            "content"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 3
            },
            "heading": {
              "type": "string",
              "maxWords": 8,
              "note": "the CMS string \"Consolidate your  existing systems\" carries a real DOUBLE SPACE"
            },
            "content": {
              "type": "string",
              "maxWords": 32
            },
            "rive": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetRole",
                "alt",
                "provenance"
              ],
              "properties": {
                "assetRole": {
                  "enum": [
                    "motion.rive-scene"
                  ]
                },
                "alt": {
                  "type": "string",
                  "maxWords": 6
                },
                "src": {
                  "type": "string"
                },
                "intrinsicWidth": {
                  "type": "integer"
                },
                "intrinsicHeight": {
                  "type": "integer"
                },
                "provenance": {
                  "enum": [
                    "source-original",
                    "operator-supplied",
                    "generated"
                  ],
                  "note": "Provenance of this asset in the page being specified. `generated` is FORBIDDEN for any assetRole whose generationPolicy is must-not-fabricate-real-brand or must-not-fabricate-compliance-claim, and for must-reuse-exact roles. Enforced by compatibility/graph.json#ASSET_PROVENANCE_POLICY and schema/semantic_validate.py."
                },
                "aspectRatio": {
                  "type": "string",
                  "note": "CSS aspect-ratio for the wrapper box (e.g. \"799/617\"). Used by Rive assets, which have no intrinsic pixel size, INSTEAD of intrinsicWidth/Height."
                }
              }
            }
          }
        }
      }
    }
  },
  "constraints": {
    "onePerPage": true,
    "routeAllowlist": [
      "/platform"
    ]
  },
  "motion": {
    "pattern": "background-colour-crossfade",
    "reducedMotionFallback": "final-colour-static",
    "backgroundTransition": {
      "property": "background-color",
      "duration": "1300ms",
      "note": "driven by CSS transition-colors duration-1300; there is no JS tween"
    },
    "panelFade": {
      "property": "opacity",
      "duration": "250ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    }
  },
  "responsive": {
    "base": "pt-20 pb-18",
    "md768": "pt-28 pb-28",
    "lg1024": "pt-50 pb-40"
  },
  "knownUpstreamDefects": [
    "A stray `hello` class sits on the panel brackets."
  ],
  "anchorId": "build",
  "notes": [
    "Each panel carries a `key` (an opaque CMS id), `label`, `heading`, `content` and a `rive` asset with its own aspectRatio. There are exactly 4 panels."
  ]
}
