    "showcase.orbit": {
      "pattern": "scroll-letter-reveal",
      "reducedMotionFallback": "all-characters-opaque",
      "source": "src/components/OrbitShowcase.jsx",
      "detail": {
        "linearity": "LINEAR in scroll, not eased — constant chars/px across 16+ samples per viewport height.",
        "startAt": "container top = 0.900 x vh",
        "spanFormula": "0.34425 * vh + 87.9px (AFFINE in vh, not a fixed px length and not a fixed fraction of vh)",
        "spanEvidence": "measured slopes 0.5782 / 0.4771 / 0.4075 chars-per-px at vh 700 / 900 / 1100; span/vh drifts monotonically (0.4694 / 0.4425 / 0.4239) which rules out a vh-proportional window; span grows 69.6px then 68.1px per 200px of vh, so growth is constant. Least-squares over the three heights gives sub-pixel residuals (-0.3 / +0.5 / -0.3 px).",
        "spring": {
          "stiffness": 120,
          "damping": 30,
          "evidence": "after an instant jump-scroll the lit count keeps climbing ~1.2s with no overshoot; residual decays with tau ~= 215ms. stiffness 120 / damping 30 has a dominant pole of 4.75 rad/s -> tau 210ms."
        },
        "perCharTransition": {
          "property": "opacity",
          "duration": "300ms"
        },
        "notes": "This affine span CANNOT be expressed as a framer `useScroll` offset pair (both offset forms are purely vh-relative); progress is driven from a measured container-top -> progress mapping re-read from the live rect each scroll frame. Do not remove the spring: without it the reveal snaps."
      }
    },
